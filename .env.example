# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Port to run the server on
PORT=3000

# Optional: Environment
NODE_ENV=development
# Supabase project config (safe publishable key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Optional direct Edge Function override
VITE_GENERATE_CHUNKS_ENDPOINT=https://your-project-ref.supabase.co/functions/v1/generate-chunks
